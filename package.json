{
  "name": "scale-new-heights-generator",
  "version": "0.2.0",
  "type": "module",
  "description": "中文攀登体表情包生成器，支持浏览器 UI 与 Node 无头 PNG 渲染。",
  "main": "./lib/sticker/index.mjs",
  "module": "./lib/sticker/index.mjs",
  "types": "./lib/sticker/index.d.mts",
  "exports": {
    ".": {
      "types": "./lib/sticker/index.d.mts",
      "import": "./lib/sticker/index.mjs"
    },
    "./core": {
      "types": "./lib/sticker/core.d.mts",
      "import": "./lib/sticker/core.mjs"
    },
    "./node": {
      "types": "./lib/sticker/node.d.mts",
      "import": "./lib/sticker/node.mjs"
    }
  },
  "files": [
    "lib",
    "public/DouyinSansBold.woff2",
    "public/YouSheBiaoTiHei.ttf",
    "README.md"
  ],
  "scripts": {
    "dev": "vite",
    "build": "pnpm run build:app && pnpm run build:package",
    "build:app": "vite build",
    "build:package": "rimraf lib && tsdown src/sticker/index.ts src/sticker/core.ts src/sticker/node.ts --out-dir lib/sticker --format esm --dts --platform node --target es2023 --tsconfig tsconfig.node.json --deps.never-bundle @napi-rs/canvas",
    "lint": "oxlint src vite.config.ts --import-plugin --react-plugin --jsx-a11y-plugin --vitest-plugin --deny-warnings",
    "preview": "vite preview",
    "test": "vitest run",
    "prepack": "pnpm run build:package"
  },
  "dependencies": {
    "colord": "^2.9.3",
    "inter-ui": "^4.1.1"
  },
  "optionalDependencies": {
    "@napi-rs/canvas": "^1.0.2"
  },
  "devDependencies": {
    "@iconify/react": "^6.0.2",
    "@tanstack/react-router": "^1.170.17",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "oxlint": "^1.73.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "rimraf": "^6.1.3",
    "tsdown": "^0.22.4",
    "typescript": "~5.9.3",
    "vite": "^8.1.3",
    "vitest": "^4.1.10"
  },
  "packageManager": "pnpm@11.10.0"
}
